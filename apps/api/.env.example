# Copy to .env and fill in. Never commit .env, and never put a real key in this file.
# Without a key the app still works: every action falls back to its rule-based answer.
GOOGLE_API_KEY=
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Optional AI tuning (defaults shown)
# AI_MODEL=gemini-2.5-flash
# AI_FIRST_TOKEN_TIMEOUT_MS=8000
# AI_IDLE_TIMEOUT_MS=5000
# AI_MIN_RETRY_WINDOW_MS=1500
# AI_MAX_TOKENS=1024
# Cost log prices in US$ per million tokens (0 = free tier)
# AI_PRICE_INPUT_PER_MTOK=0
# AI_PRICE_OUTPUT_PER_MTOK=0
