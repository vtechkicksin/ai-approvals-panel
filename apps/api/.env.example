# Copy to .env and fill in. Never commit .env.
# Without a key the app still works: every action falls back to its rule-based answer.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PORT=4000
WEB_ORIGIN=http://localhost:5173

